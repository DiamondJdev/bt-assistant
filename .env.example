# Copy to .env and fill in values. .env is loaded by both `bt` and `bt-dev`,
# But overriden by .env.dev in `bt-dev`

# Local LLM (Ollama)
BT_OLLAMA_URL=http://127.0.0.1:11434
BT_OLLAMA_MODEL=qwen3:8b

# Cloud fallback
OPENAI_API_KEY=
BT_OPENAI_MODEL=gpt-5.6-luna

# TTS
BT_PIPER_VOICE=en_US-lessac-medium
BT_PIPER_BIN=piper

# STT
BT_WHISPER_MODEL=base.en
BT_WHISPER_DEVICE=auto
BT_WHISPER_COMPUTE=default

# Keep loopback behind Tailscale Serve for private HTTPS. BT has no login and
# refuses any bind other than loopback or a Tailscale address.
BT_HOST=127.0.0.1

# Storage
BT_DB_PATH=bt.sqlite3

# Voice pipeline (off unless "1")
BT_VOICE=0

# Developer tooling
BT_DEVELOPER_MODE=0
BT_DEVUI=0

# Tools, memory, skills
BT_TOOLS=1
BT_MEMORY_DIR=memory
# BT_OPERATOR_NAME=
